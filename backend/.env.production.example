# Production environment template.
# For Supabase, copy the "Connection string" (Session pooler, port 5432) from
# Project Settings → Database, and paste it as DATABASE_URL including the password.

SECRET_KEY=generate-a-50-char-random-string
DEBUG=False
ALLOWED_HOSTS=your-api-domain.com,portfolio-cms-api.onrender.com

# Supabase Postgres (Session pooler). Replace [PASSWORD] and the pooler host/region.
DATABASE_URL=postgresql://postgres.ystrwluykagppzrtuklt:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Frontends (admin + public site) allowed to call the API.
CORS_ALLOWED_ORIGINS=https://your-admin.vercel.app,https://your-portfolio.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-admin.vercel.app,https://your-portfolio.vercel.app

# Email (swap console backend for real SMTP in production).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@your-domain.com
CONTACT_RECIPIENT=you@your-domain.com

# First admin user, provisioned by `python manage.py init_admin` on release.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=you@your-domain.com
DJANGO_ADMIN_PASSWORD=change-me-strong
